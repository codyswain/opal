{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@/*": [
        "src/*"
      ],
      "node-diff3": [
        "node_modules/node-diff3/src/diff3.d.ts"
      ]
    },
    "forceConsistentCasingInFileNames": false
  },
  "exclude": [
    "node_modules",
    "out",
    "dist",
    ".vite",
    ".worktrees"
  ]
}
